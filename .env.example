# ── 이 파일을 .env 로 복사해서 채운다 (.env 는 GitHub 에 올라가지 않는다) ──

# ① 링크드 봇 토큰 — @BotFather 에서 새 봇을 만들고 받은 토큰
HQ_TG_BOT_TOKEN=

# ③ 비밀번호 링크드봇 토큰 — 🛑 반드시 ① 과 «다른 봇» (같으면 비밀번호가 Claude 대화로 들어간다)
AUTH_TG_BOT_TOKEN=

# 사장님 텔레그램 chat_id — 봇에게 아무 글이나 보낸 뒤 `npm run chat-id` 로 확인
TELEGRAM_CHAT_ID=

# ④ (선택) 알림 전용 봇 토큰 — 비우면 ① 링크드 봇으로 보낸다
TELEGRAM_BOT_TOKEN=

# Claude 가 일할 폴더 (CLAUDE.md·메모리가 있는 곳). 비우면 이 리포의 workspace 폴더
WORK_DIR=

# (선택) claude.exe 위치 — 비우면 %USERPROFILE%\.local\bin\claude.exe
CLAUDE_EXE=

# (선택) 링크드가 쓸 모델 — 비우면 claude-opus-5
CLAUDE_MODEL=

# (선택) 작업 크롬 CDP 포트 — 비밀번호 봇이 이 크롬의 로그인 칸에 값을 넣는다
CDP_PORT=9888

# (선택) 할 일 판 todo.cjs 경로 — 없으면 /할일 명령은 꺼진다
TODO_JS=
